{
  "expo": {
    "name": "IoT Telemetry Core",
    "slug": "hivemq-mqtt-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.hivemqmqttapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSBluetoothPeripheralUsageDescription": "Allow $(PRODUCT_NAME) to discover and configure edge devices over Bluetooth."
      }
    },
    "android": {
      "package": "com.anonymous.hivemqmqttapp",
      "permissions": [
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-status-bar",
      "expo-build-properties",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to nearby Bluetooth hardware."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "2988ff39-ad3a-4326-a023-b3b6960f28a8"
      }
    }
  }
}
